        <script><![CDATA[function onLoad() {
    var areAnyCorrect = new GlideAjax("QuizHelper");
    areAnyCorrect.addParam('sysparm_name', 'getAnswersNum');
    areAnyCorrect.addParam('sysparm_question', g_form.getValue("question"));
    areAnyCorrect.getXML(ParseQuizUtil);

    function ParseQuizUtil(response) {
        var answer = response.responseXML.documentElement.getAttribute("answer");
		g_form.showFieldMsg("question", "Current answers for this question: " + answer);
    }
   
}]]></script>
